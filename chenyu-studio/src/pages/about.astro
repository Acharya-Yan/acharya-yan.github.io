---
import Base from '../layouts/Base.astro';
import Contact from '../components/Contact.astro';
import Icon from '../components/Icon.astro';
import { equipment } from '../data/site';
---
<Base title="关于" description="你好，我是严晨宇。先从我的工作室认识我。">
  <section class="about-intro shell">
    <div class="about-copy">
      <p class="about-label" lang="en">ABOUT / A LITTLE ABOUT ME</p>
      <h1 lang="en">
        <span>Hi, I'm Chenyu. 👋</span>
        <span>I build things &amp; capture moments.</span>
      </h1>
      <div class="about-description">
        <p>一个AI Native 设计与生活的创造者。</p>
        <p>用代码实现想法，用镜头记录瞬间。在这里分享我正在创造的产品，以及沿途遇见的有趣事物。</p>
      </div>
    </div>
    <img class="about-avatar" src="/assets/about-portrait.webp" alt="严晨宇的漫画形象，戴透明框眼镜，穿白色卫衣，坐在办公椅上" width="592" height="968" fetchpriority="high" />
  </section>
  <section id="my-desk" class="desk-story shell">
    <div class="section-heading"><h2>我的桌面，我的日常。</h2><span class="serif section-aside">Behind the screen</span></div>
    <div class="desk-story-layout"><img src="/assets/desk.webp" alt="左侧笔记本、中央主显示器与挂灯、白色键盘、平板、手机、音箱和右侧游戏主机组成的桌搭" width="1448" height="1086" loading="lazy"/><div class="equipment-list">{equipment.map((item,index) => <details open={index === 0}><summary>{item.name}<Icon name="plus" size={18}/></summary><p>{item.description}</p></details>)}</div></div>
  </section>
  <section class="about-later shell"><span class="serif">Still becoming.</span><div><h2>介绍还在慢慢补全。</h2><p>经历、兴趣、最近在做的事情，<br/>都会陆续放进来。</p><a class="text-link" href="/work/">先看看正在做的事 <Icon size={17}/></a></div></section>
  <Contact/>
</Base>

<style>
  .about-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(32px, 6vw, 96px);
    padding-block: clamp(48px, 6vw, 88px);
  }

  .about-label {
    color: var(--muted);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: .08em;
    margin-bottom: 20px;
  }

  .about-copy h1 {
    font-size: clamp(30px, 3.35vw, 52px);
    font-weight: 700;
    line-height: 1.17;
    text-wrap: pretty;
  }

  .about-copy h1 span {
    display: block;
  }

  .about-copy h1 span + span {
    margin-top: .18em;
  }

  .about-description {
    display: grid;
    gap: 8px;
    max-width: 32em;
    margin-top: 28px;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.85;
  }

  .about-avatar {
    justify-self: center;
    width: min(100%, 320px);
    height: auto;
  }

  @media (max-width: 700px) {
    .about-intro {
      grid-template-columns: minmax(0, 1fr);
    }

    .about-avatar {
      width: min(66%, 255px);
    }
  }
</style>
