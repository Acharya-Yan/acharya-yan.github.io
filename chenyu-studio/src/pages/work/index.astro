---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../data/site';
const works = (await getCollection('work', ({ data }) => site.showDrafts || !data.draft)).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="作品" description="正在做的事，和已经走过的过程。">
  <div class="page-content shell">
    <header class="page-heading"><h1>作品<span class="serif">Selected work.</span></h1><p>有些想法，值得认真做出来。<br/>这里收集它们从开始到完成的过程。</p></header>
    <div class="collection-bar"><span>所有作品</span><span>{String(works.length).padStart(2,'0')} 个项目</span></div>
    <div class="work-collection">{works.map(work => <a href={`/work/${work.id}/`} class="work-entry">
      <div class="work-entry-image"><img src={work.data.cover ?? '/assets/desk.webp'} alt={work.data.coverAlt ?? work.data.title} width="1448" height="1086" loading="lazy"/><span class="art-open"><Icon size={24}/></span></div>
      <div class="work-entry-text"><div><h2>{work.data.title}</h2><p>{work.data.summary}</p></div><span>{work.data.category}<small>{work.data.draft ? '进行中' : work.data.date.getUTCFullYear()}</small></span></div>
    </a>)}</div>
    <div class="collection-end"><span class="serif">More to come.</span><p>{works.length ? '下一个想法，正在路上。' : '作品正在整理，之后会放在这里。'}</p><a class="text-link" href="/">回工作室坐坐 <Icon size={16}/></a></div>
  </div>
</Base>
